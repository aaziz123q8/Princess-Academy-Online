# Copy to .env and fill in. On Hostinger, set these in the Node.js app's
# environment variables panel (hPanel → Advanced → Node.js), NOT in a committed file.

# HTTP port the Node app listens on (Hostinger assigns/expects one; default 3000)
PORT=3000

# --- MySQL (Hostinger: create a database + user in hPanel → Databases → MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456_princess
DB_PASSWORD=change_me_strong_password
DB_NAME=u123456_princess_academy

# --- Auth ---
# Generate a long random secret, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed browser origins for CORS.
# In production this is your site, e.g. https://your-domain.com
# Leave as * only for local development.
CORS_ORIGINS=*

# Serve the built client (client/dist) from this Node app? (true/false)
# true  = single Node app serves both the game and the API (VPS-style).
# false = you upload client/dist to public_html separately (shared hosting).
SERVE_CLIENT=true
