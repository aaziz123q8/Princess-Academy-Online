# ============================================================================
#  Princess Academy Online — Apache config for serving the built game from the
#  repository root on Hostinger (shared hosting / public_html).
#  The built client (index.html + assets/) sits at the root; source folders are
#  blocked from the web for security.
# ============================================================================

# The 3D game is the homepage.
DirectoryIndex index.html

# Never list directory contents.
Options -Indexes

# --- Block source & sensitive folders from being served over the web ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(\.git|server|docs|node_modules)(/|$) - [F,L]
  RewriteRule ^client(/|$) - [F,L]
</IfModule>

# --- Deny all dotfiles (.env, .gitignore, .htaccess itself, etc.) ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# --- Long-cache the hashed, immutable build assets; keep HTML fresh ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript       "access plus 1 year"
  ExpiresByType text/css              "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Correct MIME type for ES module scripts (older Apache defaults) ---
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/wasm .wasm
</IfModule>
